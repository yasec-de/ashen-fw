+        // the exact position, race-free. HTF/TCF still fire at the half-way
+        // point and at wrap, so wake granularity is unchanged.
+        let table = Table::new([unsafe { LinearItem::new_read(request, peri_addr, buffer) }]);
+
+        // With a single LLI the half-buffer wake comes from the HTF event
+        // rather than the per-half-item TCF, so the half-transfer interrupt
+        // must always be on; TCF (at wrap) drives the complete counter.
+        let mut options = options;
